# Sao chép thành .env.local để bật ghi dữ liệu thật.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Chỉ server đọc khoá AFSC. Không có URL = KHÔNG có dữ liệu cảm biến trực tiếp.
AFSC_API_URL=
AFSC_API_TOKEN=
CRON_SECRET=
# Máy chủ định tuyến riêng / dịch vụ OSRM được phép sử dụng trong sản phẩm chính thức.
# Bỏ trống: máy chủ thử nghiệm công cộng (chỉ dùng phát triển cá nhân).
ROUTING_BASE_URL=
# TomTom Traffic Flow + routing. SERVER-ONLY; NEVER use NEXT_PUBLIC_.
# Obtain at https://developer.tomtom.com/ . Without it only OSRM routes work.
TOMTOM_API_KEY=
# Danh mục camera công khai rin2401 (ảnh tĩnh). Đặt false để tắt.
CITYPASS_PUBLIC_CAMERAS=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional domain-restricted MapTiler PUBLIC browser key for faster, hosted base-map tiles.
# This key appears in browser requests: protect it with MapTiler domain restrictions.
NEXT_PUBLIC_CITYPASS_MAPTILER_KEY=
